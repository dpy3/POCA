{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "POCA evidence verification v1.0 manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "campaign_id",
    "artifacts",
    "results",
    "call_log_path",
    "engine",
    "runs"
  ],
  "properties": {
    "schema_version": {
      "const": "poca-verify-1.0"
    },
    "campaign_id": {
      "type": "string",
      "minLength": 1
    },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/artifact"
      }
    },
    "results": {
      "type": "object",
      "additionalProperties": false,
      "required": ["files", "columns"],
      "properties": {
        "files": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["path"],
            "properties": {"path": {"type": "string", "minLength": 1}}
          }
        },
        "columns": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "campaign_id_column", "run_id_column", "result_row_id_column",
            "source_id_column", "source_sha256_column", "runner_id_column",
            "task_id_column", "dimension_column", "seed_column",
            "logging_mode_column", "run_status_column", "target_fe_column",
            "reported_fe_column", "solver_nfev_required"
          ],
          "properties": {
            "campaign_id_column": {"type": "string", "minLength": 1},
            "run_id_column": {"type": "string", "minLength": 1},
            "result_row_id_column": {"type": "string", "minLength": 1},
            "source_id_column": {"type": "string", "minLength": 1},
            "source_sha256_column": {"type": "string", "minLength": 1},
            "runner_id_column": {"type": "string", "minLength": 1},
            "task_id_column": {"type": "string", "minLength": 1},
            "dimension_column": {"type": "string", "minLength": 1},
            "seed_column": {"type": "string", "minLength": 1},
            "logging_mode_column": {"type": "string", "minLength": 1},
            "run_status_column": {"type": "string", "minLength": 1},
            "target_fe_column": {"type": "string", "minLength": 1},
            "reported_fe_column": {"type": "string", "minLength": 1},
            "solver_nfev_column": {"type": ["string", "null"]},
            "solver_nfev_required": {"type": "boolean"}
          }
        }
      }
    },
    "call_log_path": {
      "type": "string",
      "minLength": 1
    },
    "engine": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version", "python", "platform"],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "python": {
          "type": "string",
          "minLength": 1
        },
        "platform": {
          "type": "string",
          "minLength": 1
        },
        "wheel_sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "runs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "run_id",
          "result_row_id",
          "results_path",
          "source_id",
          "source_path",
          "runner_id",
          "budget_policy",
          "requested_checks"
        ],
        "properties": {
          "run_id": {
            "type": "string",
            "minLength": 1
          },
          "result_row_id": {
            "type": "string",
            "minLength": 1
          },
          "results_path": {"type": "string", "minLength": 1},
          "source_id": {"type": "string", "minLength": 1},
          "source_path": {"type": "string", "minLength": 1},
          "runner_id": {"type": "string", "minLength": 1},
          "budget_policy": {
            "enum": ["upper_bound", "exact"]
          },
          "requested_checks": {
            "type": "object",
            "additionalProperties": false,
            "required": ["path", "replay", "observer"],
            "properties": {
              "path": {"type": "boolean"},
              "replay": {"type": "boolean"},
              "observer": {"type": "boolean"}
            }
          }
        }
      }
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "role", "hash_mode", "sha256"],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[^\\]+$"
        },
        "role": {
          "enum": ["source", "runner", "configuration", "results", "call_log"]
        },
        "hash_mode": {
          "enum": ["text-lf-v1", "binary-exact-v1"]
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    }
  }
}
