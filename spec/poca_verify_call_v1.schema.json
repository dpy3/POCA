{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "POCA wrapper objective-call record v1.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "campaign_id",
    "run_id",
    "call_index",
    "caller"
  ],
  "properties": {
    "schema_version": {
      "const": "poca-call-1.0"
    },
    "campaign_id": {
      "type": "string",
      "minLength": 1
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "call_index": {
      "type": "integer",
      "minimum": 1
    },
    "caller": {
      "type": "string",
      "minLength": 1
    }
  }
}
